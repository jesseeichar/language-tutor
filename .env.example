# Copy to .env (Bun loads it automatically). Values are optional except for the features noted below.

# Folder holding Deutsch_Vokabular.md and Deutsch_Grammatik.md. Needed only for `bun run import:notes`.
LT_NOTES_DIR=/path/to/Obsidian/German

# Git-trackable live progress. Defaults to ./data/progress.json
# LT_PROGRESS_PATH=./data/progress.json

# Where question and content JSON lives. Defaults to ./data
# LT_DATA_DIR=./data

# LT_API_PORT=3001
# LT_WEB_PORT=5173

# HTTPS port for bun run share (default 443)
# LT_TAILSCALE_PORT=443
# Required for translation quizzes. Obtain an official key at https://console.typesafe.ai/.
# Keep the real key in .env, never in Git or a VITE_ variable.
# TYPESAFE_API_KEY=your-key
# TYPESAFE_MODEL=jev-latest

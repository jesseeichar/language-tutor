{
  "name": "language-tutor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:api": "bun --watch src/server/main.ts",
    "dev:web": "bun --bun vite",
    "validate": "bun run scripts/validate-data.ts",
    "import:notes": "bun run scripts/import-notes.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:unit && bun run test:ui && bun run test:arch",
    "check": "bun run typecheck && bun run test && bun run validate",
    "test:unit": "bun test ./src/shared ./src/server ./scripts",
    "test:ui": "bun test --preload ./tests/setup/dom.ts ./src/client",
    "test:arch": "bun test ./tests/architecture",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
